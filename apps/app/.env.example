# Convex deployment the browser connects to.
#
# REQUIRED -- `bun run build` hard-fails without it. BUILD-TIME: Next inlines
# NEXT_PUBLIC_* into the bundle, so changing it needs `rm -rf .next` and a full
# rebuild. Restarting the service is a no-op.
#
# Self-hosted behind the edge proxy (what production uses):
#   NEXT_PUBLIC_CONVEX_URL=https://app.ollasuper.com/__cvx
# Convex Cloud:
#   NEXT_PUBLIC_CONVEX_URL=https://<deployment>.convex.cloud
NEXT_PUBLIC_CONVEX_URL=

# Resend
RESEND_API_KEY=

# OpenPanel
NEXT_PUBLIC_OPENPANEL_CLIENT_ID=
OPENPANEL_SECRET_KEY=

# Sentry
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=