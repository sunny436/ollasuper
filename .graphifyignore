# Graphify corpus exclusions (.gitignore syntax, evaluated after .gitignore and
# winning on conflict). .gitignore is already honoured automatically, so
# node_modules/, .next/, .venv/, __pycache__/, build/, dist/ and every .env file
# are excluded without being repeated here.
#
# What follows is only what .gitignore does NOT cover but which would still be
# noise or actively misleading in a code knowledge graph.

# Graphify's own output — indexing the graph into the graph.
graphify-out/

# Machine-generated Convex API surface. Regenerated by `convex codegen` from the
# function files themselves, so every node here is a duplicate of a real one and
# every edge is an artifact of codegen, not of the design.
packages/backend/convex/_generated/

# Vendored/lock artifacts: enormous, zero architectural signal.
bun.lock
uv.lock
services/ai/uv.lock

# Binary and asset files with no extractable structure.
*.png
*.jpg
*.jpeg
*.ico
*.webp
*.woff
*.woff2

# Editor/agent state, not project source.
.vscode/
.claude/
.turbo/

# Secrets and key material — belt-and-braces. .gitignore already excludes .env
# and *.env.local, but an untracked stray must never reach an LLM or the graph.
*.env
.env*
*.pem
*.key
*.p12
*_rsa
*_ed25519
**/.env.local
**/.env.production
