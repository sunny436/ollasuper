# Replica secrets. Throwaway values — this stack is meant to be broken.
CONVEX_INSTANCE_NAME=myos-replica
# openssl rand -hex 32
CONVEX_INSTANCE_SECRET=
CONVEX_DB_PASSWORD=replica
KNOWLEDGE_DB_PASSWORD=replica
# Pin to the digest production runs, so a drill proves the version that ships.
CONVEX_IMAGE=ghcr.io/get-convex/convex-backend:latest

# --- host processes (myos-ai / myos-scheduler read services/ai/.env) ---------
# SMTP is allowed here and ONLY here: production's SMTP_HOST is a local catcher
# that would swallow real reports.
#
# READ THIS BEFORE COPYING THE FOUR MAIL LINES BELOW. They are listed here for
# completeness, but the mail transport is read by CONVEX, from the CONVEX
# DEPLOYMENT ENV — not from this file, which only feeds myos-ai and
# myos-scheduler. Putting them here alone does nothing. This exact confusion is
# why deploy/71's production guard never fired: it grepped services/ai/.env
# while the live value sat in the Convex env, and production mailed into Mailpit
# for weeks. Set them against the replica's backend:
#
#   cd packages/backend
#   node ../../node_modules/convex/bin/main.js env set ALLOW_SMTP_TRANSPORT 1
#   node ../../node_modules/convex/bin/main.js env set SCHEDULED_EMAIL_TRANSPORT smtp
#   node ../../node_modules/convex/bin/main.js env set SMTP_HOST 127.0.0.1
#
# ALLOW_SMTP_TRANSPORT=1 is REQUIRED: convex/email.ts refuses `smtp` whenever
# SITE_URL is not loopback. It is the explicit "yes, this really is the replica"
# opt-in, and there is deliberately no way to get it by accident.
ALLOW_SMTP_TRANSPORT=1
SCHEDULED_EMAIL_TRANSPORT=smtp
SCHEDULED_DELIVERY_ENABLED=true
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
AI_SCHEDULED_TASKS_ENABLED=true
SCHEDULER_DATABASE_URL=postgresql://myos_dbos:replica@127.0.0.1:5434/myos_dbos?sslmode=disable
