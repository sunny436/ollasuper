{
  "openapi": "3.1.0",
  "info": { "title": "Ollagraph API (fixture)", "version": "1.0.0" },
  "servers": [{ "url": "https://api.ollagraph.test" }],
  "security": [{ "BearerAuth": [] }],
  "paths": {
    "/v1/scrape": {
      "post": {
        "operationId": "scrape_endpoint_v1_scrape_post",
        "summary": "Scrape Endpoint",
        "description": "Scrape a page.",
        "tags": ["Scraping"],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ScrapeRequest" } } }
        },
        "responses": {
          "200": { "description": "ok", "content": { "application/json": { "schema": {} } } },
          "422": { "description": "err", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HTTPValidationError" } } } }
        }
      }
    },
    "/v1/intel/whoami": {
      "get": {
        "operationId": "whoami_v1_intel_whoami_get",
        "summary": "Whoami",
        "tags": ["Intelligence"],
        "responses": { "200": { "description": "ok", "content": { "application/json": { "schema": {} } } } }
      }
    },
    "/v1/keys": {
      "post": {
        "operationId": "create_my_key_v1_keys_post",
        "summary": "Create My Key",
        "tags": ["Account"],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateKeyRequest" } } }
        },
        "responses": { "200": { "description": "ok", "content": { "application/json": { "schema": {} } } } }
      }
    },
    "/v1/keys/{key_id}": {
      "delete": {
        "operationId": "delete_my_key_v1_keys_key_id_delete",
        "summary": "Delete My Key",
        "tags": ["Account"],
        "responses": { "200": { "description": "ok", "content": { "application/json": { "schema": {} } } } }
      }
    },
    "/v1/session": {
      "post": {
        "operationId": "create_session_v1_session_post",
        "summary": "Create Session",
        "tags": ["Automation"],
        "responses": { "200": { "description": "ok", "content": { "application/json": { "schema": {} } } } }
      }
    },
    "/v1/scrape/async": {
      "post": {
        "operationId": "scrape_async_v1_scrape_async_post",
        "summary": "Scrape Async",
        "tags": ["Scraping"],
        "responses": { "200": { "description": "ok", "content": { "application/json": { "schema": {} } } } }
      }
    },
    "/v1/admin/rotate": {
      "post": {
        "operationId": "admin_rotate_v1_admin_rotate_post",
        "summary": "Admin Rotate",
        "tags": ["Account"],
        "security": [{ "AdminToken": [] }],
        "responses": { "200": { "description": "ok", "content": { "application/json": { "schema": {} } } } }
      }
    },
    "/v1/text/similarity": {
      "get": {
        "operationId": "similarity_get_v1_text_similarity_get",
        "summary": "Similarity Get",
        "tags": ["Other"],
        "responses": { "200": { "description": "ok", "content": { "application/json": { "schema": {} } } } }
      },
      "post": {
        "operationId": "similarity_post_v1_text_similarity_post",
        "summary": "Similarity Post",
        "tags": ["Other"],
        "responses": { "200": { "description": "ok", "content": { "application/json": { "schema": {} } } } }
      }
    },
    "/v1/dup1": {
      "post": {
        "operationId": "dup_op",
        "summary": "Dup One",
        "tags": ["Testing"],
        "responses": { "200": { "description": "ok", "content": { "application/json": { "schema": {} } } } }
      }
    },
    "/v1/dup2": {
      "post": {
        "operationId": "dup_op",
        "summary": "Dup Two",
        "tags": ["Testing"],
        "responses": { "200": { "description": "ok", "content": { "application/json": { "schema": {} } } } }
      }
    },
    "/v1/tree": {
      "post": {
        "operationId": "tree_v1_tree_post",
        "summary": "Tree",
        "tags": ["Scraping"],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SelfRef" } } }
        },
        "responses": { "200": { "description": "ok", "content": { "application/json": { "schema": {} } } } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": { "type": "http", "scheme": "bearer" },
      "AdminToken": { "type": "apiKey", "in": "header", "name": "X-Admin-Token" }
    },
    "schemas": {
      "ScrapeRequest": {
        "type": "object",
        "title": "ScrapeRequest",
        "required": ["url"],
        "properties": {
          "url": { "type": "string", "title": "Url" },
          "format": { "type": "string", "enum": ["markdown", "html"], "default": "markdown" },
          "timeout": { "type": "integer", "maximum": 60, "minimum": 1, "default": 30 }
        }
      },
      "CreateKeyRequest": {
        "type": "object",
        "title": "CreateKeyRequest",
        "properties": {
          "label": { "type": "string", "default": "user-created" }
        }
      },
      "SelfRef": { "$ref": "#/components/schemas/SelfRef" },
      "HTTPValidationError": {
        "type": "object",
        "properties": {
          "detail": { "type": "array", "items": { "$ref": "#/components/schemas/ValidationError" } }
        }
      },
      "ValidationError": {
        "type": "object",
        "required": ["loc", "msg", "type"],
        "properties": {
          "loc": { "type": "array", "items": { "type": "string" } },
          "msg": { "type": "string" },
          "type": { "type": "string" }
        }
      }
    }
  }
}
