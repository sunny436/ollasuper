# myos AI inference plane — copy to .env (chmod 600) and fill in.
# deploy/54-ai-service.sh generates this file with random secrets already set;
# the ONLY value an operator must supply by hand is OPENROUTER_API_KEY.

# --- binding ---------------------------------------------------------------
# Loopback only. The browser never talks to this service — Convex is the
# streaming substrate — so there is no reason to expose it on the network.
#
# Do NOT move this to 8000: deploy/47-glitchtip.sh runs a cloudflared tunnel
# from a public trycloudflare.com URL to http://localhost:8000, so binding
# there would publish the inference plane to the internet.
AI_BIND_HOST=127.0.0.1
AI_PORT=8770

# --- server-to-server secrets ----------------------------------------------
# Must match the values set on the Convex deployment:
#   convex env set AI_SERVICE_KEY     <same>
#   convex env set AI_INGRESS_SECRET  <same>
# Generate with: openssl rand -hex 24
AI_SERVICE_KEY=
AI_INGRESS_SECRET=

# --- Convex ----------------------------------------------------------------
# CONVEX_SITE_URL is the PUBLIC origin and is used only as the JWT issuer — it
# must match tokens byte-for-byte (see deploy/28-fix-issuer.sh).
# CONVEX_INTERNAL_URL is where this service actually sends traffic, and stays
# on loopback so it survives the Caddy / Cloudflare cutovers.
CONVEX_SITE_URL=http://127.0.0.1:3211
CONVEX_INTERNAL_URL=http://127.0.0.1:3211
CONVEX_AUDIENCE=convex

# --- OpenRouter (embeddings, title-gen, OCR) -------------------------------
# REQUIRED. Never generated, never defaulted, never committed.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_URL=https://leads.networkershome.com
OPENROUTER_APP_TITLE=myos

# --- Ollima (user-chat generation ONLY) ------------------------------------
# REQUIRED. OpenAI-compatible; chat needs a Bearer key (401 without).
# Never generated, never defaulted, never committed.
OLLIMA_API_KEY=
OLLIMA_BASE_URL=https://api.ollima.com/v1

# --- Ollagraph tool provider (Phase 1: discovery/registry ONLY) ------------
# OPTIONAL and OFF by default. Set OLLAGRAPH_BASE_URL to enable Tool Registry
# discovery from the PUBLIC OpenAPI spec (no key needed to discover). The key
# is stored for a FUTURE execution phase only; it is never logged or sent to
# the browser/LLM. Nothing here is wired to chat — leaving these blank changes
# nothing.
OLLAGRAPH_BASE_URL=
OLLAGRAPH_API_KEY=
# OLLAGRAPH_OPENAPI_URL=   # optional; defaults to ${OLLAGRAPH_BASE_URL}/openapi.json

AI_DEFAULT_MODEL=gpt-5.6-luna
AI_TITLE_MODEL=google/gemini-2.0-flash-001
AI_MAX_OUTPUT_TOKENS=8192

# --- context ---------------------------------------------------------------
# 32k, not the model's 1M window: a full 32k context is ~$0.16/turn on Opus-5,
# while 1M would be ~$5.00 per message.
AI_CONTEXT_BUDGET_TOKENS=32000
AI_TOKEN_SAFETY_FACTOR=1.35

# --- delta writer ----------------------------------------------------------
# The interval is a latency CEILING; the char target is the real trigger. At a
# realistic ~280 chars/s a 100ms floor produces ~32-char batches and ~944KB of
# downstream traffic per viewer on an 8k answer. Do not lower this without
# re-reading app/runtime/writer.py.
AI_FLUSH_MIN_INTERVAL_MS=300
AI_FLUSH_MAX_INTERVAL_MS=700
AI_FLUSH_MIN_CHARS=96
AI_FLUSH_MAX_CHARS=512

# --- resource protection ---------------------------------------------------
# Per-user quota policy belongs in Convex, where the identity lives. These only
# stop one process being swamped.
AI_MAX_CONCURRENT_PER_USER=2
AI_MAX_CONCURRENT_GLOBAL=32

# --- attachments -----------------------------------------------------------
# pypdf extracts text server-side and always works. "openrouter" uses the
# file-parser plugin, which needs ChatOpenAI to forward an unrecognised
# content-part dict AND extra_body.plugins untouched — verify before switching.
AI_PDF_ENGINE=pypdf
AI_MAX_IMAGES_PER_TURN=4

# --- feature flags ---------------------------------------------------------
# `app/config.py` is the AUTHORITY for the full list and the defaults; nothing
# is duplicated here, because a second list is a list that drifts. Set a name
# here only to override its default on this deployment.
#
# The capability flags (AI_SEO_ENABLED, AI_BLOG_ENABLED, AI_RESEARCH_ENABLED,
# AI_DATA_ANALYSIS_ENABLED, AI_SALES_ENABLED, AI_HR_ENABLED, AI_FINANCE_ENABLED,
# AI_MARKETING_ENABLED, AI_OPERATIONS_ENABLED, AI_DOCUMENTS_ENABLED, …) are all
# OFF by default: an unset flag means the skill, its intents and its tools are
# never registered, and the runner is byte-identical to a build without it.
#
# Two are called out because they behave unusually:
#
#   AI_USER_SKILLS_ENABLED (default off) — whether user-authored custom skills
#   are READ. Convex always sends them; this decides whether the runtime uses
#   them, so the whole feature can be turned on or off without redeploying the
#   data plane.
#
#   AI_SKILL_CAPABILITY_RESOLUTION_ENABLED (default ON) — resolves a skill's
#   declared capabilities through the intent map before reserving them. This is
#   the ONE flag here that is on by default and that affects BUILT-IN skills for
#   every user, whether or not custom skills are enabled. Set it to 0 to restore
#   the pre-Phase-6 behaviour without a redeploy.
# AI_USER_SKILLS_ENABLED=1
# AI_SKILL_CAPABILITY_RESOLUTION_ENABLED=0

# --- logging ---------------------------------------------------------------
AI_LOG_LEVEL=INFO
# Logs user message content at DEBUG. Off by default for obvious reasons.
AI_LOG_CONTENT=0

# LangSmith is DISABLED deliberately. Enabling it ships full prompts and
# completions to a third-party US SaaS, which contradicts this stack's entire
# self-hosted premise. That is a policy decision, not a default.
LANGSMITH_TRACING=false
