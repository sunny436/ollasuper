[Unit]
Description=myos edge proxy (Host routing on :5150 for the dashboard-managed CF tunnel)
After=network.target myos-app.service

[Service]
Type=simple
ExecStart=/usr/bin/node /opt/myos-edge/proxy.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
